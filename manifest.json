{
  "manifest_version": 3,
  "name": "GitHub PR Redline",
  "version": "1.4.0",
  "description": "Tints GitHub pull request pages when the PR targets a protected branch, and lists the other open PRs into those branches.",
  "permissions": ["storage"],
  "action": {
    "default_title": "GitHub PR Redline",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["settings.js", "pr-list.js", "list-highlight.js", "content.js"],
      "css": ["redline.css"],
      "run_at": "document_idle"
    }
  ]
}
