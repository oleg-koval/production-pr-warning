{
  "manifest_version": 3,
  "name": "PR Redline - Production PR warning",
  "version": "1.5.0",
  "description": "Tints GitHub pull requests by their target branch, in colours you choose, so a production PR never passes for a staging one.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "PR Redline",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "settings.js",
        "pr-list.js",
        "list-highlight.js",
        "content.js"
      ],
      "css": [
        "redline.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "short_name": "PR Redline"
}
